<svg viewBox="0 0 760 470" xmlns="http://www.w3.org/2000/svg" font-family="Sora, sans-serif">
  <defs>
    <marker id="bf4arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#42505e" />
    </marker>
  </defs>
  <text x="380" y="26" text-anchor="middle" font-size="17" fill="#232f3e" font-weight="700">Peta model harga compute AWS</text>
  <text x="380" y="46" text-anchor="middle" font-size="12" fill="#64748b">Sumbu: makin ke kanan makin butuh komitmen, makin ke atas makin besar diskon.</text>

  <line x1="120" y1="380" x2="700" y2="380" stroke="#42505e" stroke-width="2" marker-end="url(#bf4arr)" />
  <line x1="120" y1="380" x2="120" y2="80" stroke="#42505e" stroke-width="2" marker-end="url(#bf4arr)" />
  <text x="410" y="404" text-anchor="middle" font-size="12" fill="#42505e" font-weight="700">Komitmen / fleksibilitas berkurang &rarr;</text>
  <text x="92" y="230" text-anchor="middle" font-size="12" fill="#42505e" font-weight="700" transform="rotate(-90 92 230)">Diskon &rarr;</text>

  <circle cx="200" cy="330" r="8" fill="#2563eb" />
  <rect x="150" y="290" width="180" height="34" rx="8" fill="#e8f2ff" stroke="#2563eb" stroke-width="2" />
  <text x="240" y="305" text-anchor="middle" font-size="12" fill="#232f3e" font-weight="700">On-Demand</text>
  <text x="240" y="319" text-anchor="middle" font-size="10" fill="#42505e">tanpa komitmen, harga penuh</text>

  <circle cx="430" cy="220" r="8" fill="#ec7211" />
  <rect x="345" y="180" width="170" height="34" rx="8" fill="#fff7ed" stroke="#ec7211" stroke-width="2" />
