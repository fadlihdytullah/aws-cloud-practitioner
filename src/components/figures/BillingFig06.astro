  <text x="535" y="132" text-anchor="middle" font-size="10" fill="#64748b">&lt; 15 Jul 2025</text>

  <rect x="40" y="144" width="320" height="200" rx="12" fill="#e8f2ff" stroke="#2563eb" stroke-width="2" />
  <text x="200" y="166" text-anchor="middle" font-size="13" fill="#2563eb" font-weight="700">Akun BARU: model kredit</text>
  <text x="200" y="188" text-anchor="middle" font-size="11" fill="#42505e">$100 saat daftar + hingga $100 dari</text>
  <text x="200" y="204" text-anchor="middle" font-size="11" fill="#42505e">5 aktivitas (~$20 tiap), total s/d $200</text>

  <rect x="58" y="220" width="138" height="48" rx="8" fill="#ffffff" stroke="#2563eb" stroke-width="1.5" />
  <text x="127" y="240" text-anchor="middle" font-size="11" fill="#232f3e" font-weight="700">Free plan</text>
  <text x="127" y="257" text-anchor="middle" font-size="9" fill="#42505e">tak ditagih sampai upgrade</text>

  <rect x="204" y="220" width="138" height="48" rx="8" fill="#ffffff" stroke="#2563eb" stroke-width="1.5" />
  <text x="273" y="240" text-anchor="middle" font-size="11" fill="#232f3e" font-weight="700">Paid plan</text>
  <text x="273" y="257" text-anchor="middle" font-size="9" fill="#42505e">bayar normal sesuai pakai</text>

  <text x="200" y="290" text-anchor="middle" font-size="10" fill="#dc2626" font-weight="700">Free plan berakhir: 6 bulan ATAU kredit habis</text>
