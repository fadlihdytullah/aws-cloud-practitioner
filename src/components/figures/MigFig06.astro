<svg viewBox="0 0 760 380" xmlns="http://www.w3.org/2000/svg" font-family="Sora, Arial, sans-serif">
  <rect x="16" y="16" width="728" height="348" rx="18" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2" />
  <text x="380" y="46" text-anchor="middle" font-size="19" fill="#232f3e" font-weight="700">Spektrum Hybrid dan Edge: dari Region ke Lokasi Terpencil</text>
  <text x="380" y="66" text-anchor="middle" font-size="11" fill="#64748b">Makin ke kanan, makin dekat ke pengguna atau lokasi fisik</text>

  <!-- axis -->
  <line x1="48" y1="124" x2="712" y2="124" stroke="#94a3b8" stroke-width="2" />
  <text x="48" y="112" text-anchor="start" font-size="10" fill="#64748b">pusat cloud</text>
  <text x="712" y="112" text-anchor="end" font-size="10" fill="#64748b">tepi jaringan</text>

  <!-- 1 Region -->
  <rect x="40" y="138" width="128" height="118" rx="12" fill="#1f6feb" />
  <circle cx="104" cy="128" r="7" fill="#1f6feb" stroke="#ffffff" stroke-width="2" />
  <text x="104" y="166" text-anchor="middle" font-size="13" fill="#ffffff" font-weight="700">AWS Region</text>
  <text x="104" y="188" text-anchor="middle" font-size="10" fill="#e0f2fe">banyak AZ</text>
  <text x="104" y="204" text-anchor="middle" font-size="10" fill="#e0f2fe">layanan penuh</text>
  <text x="104" y="234" text-anchor="middle" font-size="10" fill="#ffffff" font-weight="700">baseline</text>

  <!-- 2 Local Zones -->
  <rect x="180" y="138" width="128" height="118" rx="12" fill="#ffffff" stroke="#0f766e" stroke-width="2" />
  <circle cx="244" cy="128" r="7" fill="#0f766e" stroke="#ffffff" stroke-width="2" />
  <text x="244" y="162" text-anchor="middle" font-size="12" fill="#0f766e" font-weight="700">Local Zones</text>
  <text x="244" y="184" text-anchor="middle" font-size="10" fill="#42505e">metro / kota</text>
  <text x="244" y="200" text-anchor="middle" font-size="10" fill="#42505e">latency 1 digit ms</text>
  <text x="244" y="230" text-anchor="middle" font-size="10" fill="#dc2626" font-weight="700">tidak in-scope</text>

  <!-- 3 Wavelength -->
  <rect x="320" y="138" width="128" height="118" rx="12" fill="#ffffff" stroke="#2563eb" stroke-width="2" />
  <circle cx="384" cy="128" r="7" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
  <text x="384" y="162" text-anchor="middle" font-size="12" fill="#2563eb" font-weight="700">Wavelength</text>
  <text x="384" y="184" text-anchor="middle" font-size="10" fill="#42505e">dalam jaringan 5G</text>
  <text x="384" y="200" text-anchor="middle" font-size="10" fill="#42505e">ultra-low latency</text>
  <text x="384" y="230" text-anchor="middle" font-size="10" fill="#dc2626" font-weight="700">tidak in-scope</text>

  <!-- 4 Outposts -->
  <rect x="460" y="138" width="128" height="118" rx="12" fill="#ec7211" />
  <circle cx="524" cy="128" r="7" fill="#ec7211" stroke="#ffffff" stroke-width="2" />
  <text x="524" y="162" text-anchor="middle" font-size="12" fill="#ffffff" font-weight="700">Outposts</text>
  <text x="524" y="184" text-anchor="middle" font-size="10" fill="#fff7ed">di data center</text>
  <text x="524" y="200" text-anchor="middle" font-size="10" fill="#fff7ed">pelanggan</text>
  <text x="524" y="230" text-anchor="middle" font-size="10" fill="#ffffff" font-weight="700">in-scope</text>

  <!-- 5 Snow edge -->
  <rect x="600" y="138" width="128" height="118" rx="12" fill="#232f3e" />
  <circle cx="664" cy="128" r="7" fill="#232f3e" stroke="#ffffff" stroke-width="2" />
  <text x="664" y="162" text-anchor="middle" font-size="12" fill="#ff9d4d" font-weight="700">Snow Family</text>
  <text x="664" y="184" text-anchor="middle" font-size="10" fill="#ffffff">lokasi terpencil</text>
  <text x="664" y="200" text-anchor="middle" font-size="10" fill="#ffffff">terputus / rugged</text>
  <text x="664" y="230" text-anchor="middle" font-size="10" fill="#ffffff" font-weight="700">in-scope</text>

  <!-- drivers row -->
  <text x="104" y="296" text-anchor="middle" font-size="10" fill="#42505e">pemicu: skala penuh</text>
  <text x="244" y="296" text-anchor="middle" font-size="10" fill="#42505e">pemicu: latency metro</text>
  <text x="384" y="296" text-anchor="middle" font-size="10" fill="#42505e">pemicu: latency 5G</text>
  <text x="524" y="296" text-anchor="middle" font-size="10" fill="#42505e">pemicu: data residency</text>
  <text x="664" y="296" text-anchor="middle" font-size="10" fill="#42505e">pemicu: tanpa koneksi</text>

  <rect x="40" y="318" width="688" height="32" rx="8" fill="#ffffff" stroke="#cbd5e1" stroke-width="1.5" />
  <text x="380" y="339" text-anchor="middle" font-size="11" fill="#232f3e">Untuk CLF-C02, hanya Outposts dan Snow Family yang in-scope; Local Zones dan Wavelength bagus dipahami tetapi tidak resmi diuji</text>
</svg>
