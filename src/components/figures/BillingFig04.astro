  <text x="430" y="209" text-anchor="middle" font-size="10" fill="#42505e">terikat atribut, diskon besar</text>

  <circle cx="470" cy="160" r="8" fill="#16a34a" />
  <rect x="395" y="118" width="180" height="36" rx="8" fill="#ecfdf5" stroke="#16a34a" stroke-width="2" />
