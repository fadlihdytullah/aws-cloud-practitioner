  <text x="560" y="166" text-anchor="middle" font-size="13" fill="#ec7211" font-weight="700">Akun LAMA: model klasik</text>

  <rect x="418" y="180" width="284" height="42" rx="8" fill="#ffffff" stroke="#ec7211" stroke-width="1.5" />
  <text x="560" y="199" text-anchor="middle" font-size="11" fill="#232f3e" font-weight="700">12 bulan gratis</text>
  <text x="560" y="214" text-anchor="middle" font-size="9" fill="#42505e">mis. 750 jam EC2 t2/t3.micro per bulan</text>

  <rect x="418" y="230" width="284" height="42" rx="8" fill="#ffffff" stroke="#ec7211" stroke-width="1.5" />
  <text x="560" y="249" text-anchor="middle" font-size="11" fill="#232f3e" font-weight="700">Always free (30+ layanan)</text>
  <text x="560" y="264" text-anchor="middle" font-size="9" fill="#42505e">mis. Lambda 1 jt request/bln, DynamoDB 25 GB</text>

  <rect x="418" y="280" width="284" height="42" rx="8" fill="#ffffff" stroke="#ec7211" stroke-width="1.5" />
  <text x="560" y="299" text-anchor="middle" font-size="11" fill="#232f3e" font-weight="700">Trial jangka pendek</text>
