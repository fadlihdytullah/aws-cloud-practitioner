<svg viewBox="0 0 760 440" xmlns="http://www.w3.org/2000/svg" font-family="Sora, sans-serif">
  <defs>
    <marker id="bf6arr" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L0,6 L9,3 z" fill="#2563eb" />
    </marker>
  </defs>
  <text x="380" y="26" text-anchor="middle" font-size="17" fill="#232f3e" font-weight="700">AWS Free Tier: akun baru vs akun lama</text>
  <text x="380" y="46" text-anchor="middle" font-size="12" fill="#64748b">Kapan akun dibuat menentukan model Free Tier yang berlaku.</text>

  <rect x="290" y="62" width="180" height="46" rx="12" fill="#232f3e" />
  <text x="380" y="82" text-anchor="middle" font-size="13" fill="#ff9d4d" font-weight="700">Akun dibuat kapan?</text>
  <text x="380" y="100" text-anchor="middle" font-size="11" fill="#ffffff">15 Juli 2025 jadi batas</text>

  <line x1="330" y1="108" x2="200" y2="140" stroke="#2563eb" stroke-width="2.5" marker-end="url(#bf6arr)" />
  <line x1="430" y1="108" x2="560" y2="140" stroke="#2563eb" stroke-width="2.5" marker-end="url(#bf6arr)" />
