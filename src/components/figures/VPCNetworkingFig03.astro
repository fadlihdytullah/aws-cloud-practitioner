<svg viewBox="0 0 760 520" xmlns="http://www.w3.org/2000/svg" font-family="Sora, Arial, sans-serif">
  <defs>
    <marker id="vpcDtArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M 0 0 L 10 5 L 0 10 z" fill="#2563eb" />
    </marker>
  </defs>
  <rect x="20" y="20" width="720" height="480" rx="18" fill="#f8fafc" stroke="#cbd5e1" stroke-width="2" />
  <text x="380" y="50" text-anchor="middle" font-size="18" fill="#232f3e" font-weight="700">Decision tree: pilih layanan koneksi dan delivery</text>

  <rect x="280" y="70" width="200" height="44" rx="10" fill="#232f3e" stroke="#232f3e" stroke-width="2" />
  <text x="380" y="97" text-anchor="middle" font-size="14" fill="#ff9d4d" font-weight="700">Apa kebutuhan utamamu?</text>

  <line x1="380" y1="114" x2="130" y2="150" stroke="#2563eb" stroke-width="2.5" marker-end="url(#vpcDtArrow)" />
  <line x1="380" y1="114" x2="380" y2="150" stroke="#2563eb" stroke-width="2.5" marker-end="url(#vpcDtArrow)" />
  <line x1="380" y1="114" x2="630" y2="150" stroke="#2563eb" stroke-width="2.5" marker-end="url(#vpcDtArrow)" />

  <text x="225" y="138" text-anchor="middle" font-size="11" fill="#475569">user akhir global</text>
  <text x="430" y="138" text-anchor="middle" font-size="11" fill="#475569">arahkan domain</text>
  <text x="560" y="138" text-anchor="middle" font-size="11" fill="#475569">sambung jaringan</text>

  <rect x="50" y="152" width="190" height="120" rx="12" fill="#fff7ed" stroke="#ec7211" stroke-width="2" />
  <text x="145" y="174" text-anchor="middle" font-size="13" fill="#9a3412" font-weight="700">Mempercepat akses user</text>
  <line x1="145" y1="184" x2="145" y2="200" stroke="#ec7211" stroke-width="2" marker-end="url(#vpcDtArrow)" />
  <rect x="62" y="202" width="166" height="28" rx="8" fill="#ffffff" stroke="#ec7211" stroke-width="1.5" />
  <text x="145" y="221" text-anchor="middle" font-size="11" fill="#232f3e">cacheable (HTTP/S)? &rarr; CloudFront</text>
  <rect x="62" y="236" width="166" height="28" rx="8" fill="#ffffff" stroke="#ec7211" stroke-width="1.5" />
  <text x="145" y="255" text-anchor="middle" font-size="11" fill="#232f3e">static IP, TCP/UDP? &rarr; Global Accel.</text>

  <rect x="300" y="152" width="160" height="86" rx="12" fill="#eff6ff" stroke="#2563eb" stroke-width="2" />
  <text x="380" y="178" text-anchor="middle" font-size="13" fill="#1d4ed8" font-weight="700">Resolusi nama</text>
  <text x="380" y="198" text-anchor="middle" font-size="11" fill="#42505e">DNS, routing policy,</text>
  <text x="380" y="214" text-anchor="middle" font-size="11" fill="#42505e">health check</text>
  <text x="380" y="231" text-anchor="middle" font-size="12" fill="#1d4ed8" font-weight="700">&rarr; Route 53</text>

  <rect x="520" y="152" width="200" height="120" rx="12" fill="#ecfdf5" stroke="#059669" stroke-width="2" />
  <text x="620" y="174" text-anchor="middle" font-size="13" fill="#047857" font-weight="700">Hubungkan kantor/VPC</text>
  <line x1="620" y1="184" x2="620" y2="200" stroke="#059669" stroke-width="2" marker-end="url(#vpcDtArrow)" />
  <rect x="532" y="202" width="176" height="28" rx="8" fill="#ffffff" stroke="#059669" stroke-width="1.5" />
  <text x="620" y="221" text-anchor="middle" font-size="11" fill="#232f3e">cepat &amp; terenkripsi? &rarr; S2S VPN</text>
  <rect x="532" y="236" width="176" height="28" rx="8" fill="#ffffff" stroke="#059669" stroke-width="1.5" />
  <text x="620" y="255" text-anchor="middle" font-size="11" fill="#232f3e">dedicated stabil? &rarr; Direct Connect</text>

  <rect x="50" y="300" width="320" height="80" rx="12" fill="#f5f3ff" stroke="#7c3aed" stroke-width="2" />
  <text x="210" y="324" text-anchor="middle" font-size="13" fill="#6d28d9" font-weight="700">Banyak VPC saling terhubung?</text>
  <text x="210" y="346" text-anchor="middle" font-size="11" fill="#42505e">2 VPC saja, 1-ke-1 &rarr; VPC Peering</text>
  <text x="210" y="366" text-anchor="middle" font-size="11" fill="#42505e">banyak VPC + on-prem, hub &rarr; Transit Gateway</text>

  <rect x="390" y="300" width="330" height="80" rx="12" fill="#eef2ff" stroke="#2563eb" stroke-width="2" />
  <text x="555" y="324" text-anchor="middle" font-size="13" fill="#1d4ed8" font-weight="700">Akses privat ke layanan AWS?</text>
  <text x="555" y="346" text-anchor="middle" font-size="11" fill="#42505e">S3/DynamoDB &rarr; Gateway endpoint (gratis)</text>
  <text x="555" y="366" text-anchor="middle" font-size="11" fill="#42505e">layanan lain &rarr; Interface endpoint (PrivateLink)</text>

  <rect x="50" y="404" width="670" height="76" rx="12" fill="#fefce8" stroke="#ca8a04" stroke-width="2" />
  <text x="385" y="428" text-anchor="middle" font-size="13" fill="#854d0e" font-weight="700">Kunci ingatan</text>
  <text x="385" y="450" text-anchor="middle" font-size="11.5" fill="#42505e">CloudFront = caching konten &middot; Global Accelerator = optimasi network path &middot; Route 53 = DNS</text>
  <text x="385" y="469" text-anchor="middle" font-size="11.5" fill="#42505e">PrivateLink = akses ke LAYANAN &middot; VPN/Direct Connect = hubungkan JARINGAN</text>
</svg>
